server:
  http_listen_port: 9080
  grpc_listen_port: 0

clients:
  - url: http://localhost:3100/loki/api/v1/push

positions:
  filename: /var/lib/promtail/positions.yaml

scrape_configs:
- job_name: containers
  static_configs:
  - targets:
      - localhost
    labels:
      job: docker-logs
      env: production
      __path__: /var/lib/docker/containers/*/*.log

  pipeline_stages:
    - docker: {}
    - json:
        expressions:
          level: level
          message: message
          timestamp: time
    - labels:
        level: level
        container_name: container_name
    - timestamp:
        source: timestamp
        format: RFC3339

- job_name: system-logs
  static_configs:
  - targets:
      - localhost
    labels:
      job: system-logs
      __path__: /var/log/syslog